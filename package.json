{
  "name": "bloom-instagram-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/smoke.cjs",
    "test:standalone": "npm run build && node tests/standalone.cjs",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test:backend": "npm run build && node --test tests/backend.test.js tests/deployment.test.js tests/postgres.test.js",
    "test:connection-ui": "node tests/connection-ui.cjs",
    "test:legal-ui": "npm run build && node tests/legal-ui.cjs",
    "test:dashboard-ui": "npm run build && node tests/dashboard-ui.cjs",
    "test:postgres": "npm run build && node --test tests/postgres.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "vite": "^6.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
