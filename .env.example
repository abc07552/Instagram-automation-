# Copy this file to .env for LOCAL DEVELOPMENT ONLY. Never commit real values.
# Node 22.13+ is required. Run npm run build, then npm start.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/bloom.sqlite
# local for development, ephemeral for temporary free testing,
# external for durable PostgreSQL on free compute, persistent ONLY with an attached disk.
STORAGE_MODE=local
# For external mode ONLY, set a private pooled PostgreSQL URL in Render Environment.
# Do not commit or paste the actual URL in chat. TLS certificates are always verified.
# DATABASE_URL=

# Copy from Meta App Settings > Basic (Meta App ID/Secret, NOT an old Instagram App ID).
META_APP_ID=
META_APP_SECRET=
# Copy the Configuration ID from API setup with Unified login.
META_LOGIN_CONFIG_ID=
META_API_VERSION=v26.0

# Generate two DIFFERENT random strings locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_PASSWORD is a private Bloom owner password, NOT your Instagram/Facebook password.
ADMIN_PASSWORD=
TOKEN_ENCRYPTION_KEY=
